{
  "name": "ownspace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname localhost",
    "build": "tsx scripts/validate-deployment.ts && next build --webpack && tsx scripts/sanitize-build-traces.ts",
    "start": "tsx scripts/validate-deployment.ts && next start --hostname localhost",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:auth": "node scripts/verify-clerk.mjs",
    "check": "npm run typecheck && npm test && npm run build:preview",
    "setup": "tsx scripts/setup.ts",
    "validate:production": "tsx scripts/validate-deployment.ts --strict",
    "format": "prettier --write app components lib scripts tests docs *.ts *.json",
    "format:check": "prettier --check app components lib scripts tests docs *.ts *.json",
    "build:preview": "tsx scripts/preview.ts build",
    "start:preview": "tsx scripts/preview.ts start",
    "moderate": "tsx scripts/moderate.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "3.37.0",
    "@clerk/nextjs": "7.9.14",
    "@composio/core": "0.23.0",
    "@electric-sql/pglite": "latest",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/manrope": "latest",
    "@phosphor-icons/react": "^2.1.10",
    "@puckeditor/core": "^0.23.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@saas-ui/chakra-preset": "latest",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "motion": "^12.0.0",
    "next": "16.4.0",
    "pg": "^8.16.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "23.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@clerk/backend": "^3.23.2",
    "@clerk/testing": "^2.2.45",
    "@playwright/test": "latest",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
