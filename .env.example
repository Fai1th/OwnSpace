# Required for production. Never commit .env.local.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
# Configure Clerk's GitHub social provider in its dashboard.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Legal operator configuration is required by npm run setup in production.
NEXT_PUBLIC_LEGAL_OPERATOR=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_JURISDICTION=
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=2026-10-14
NEXT_PUBLIC_MINIMUM_AGE=16
# One-time Premium: set all three server variables together. See docs/STRIPE.md.
# Use matching test/live mode; prefer a restricted API key. No browser Stripe key needed.
# Snapshot webhook endpoint: /api/webhooks/stripe (API 2026-09-30.endive).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
# Match the active Stripe one-time Price exactly; amount is in minor currency units.
# Escape the dollar sign in local dotenv files. In Vercel UI, enter plain $12.
NEXT_PUBLIC_PREMIUM_PRICE_LABEL=\$12
NEXT_PUBLIC_PREMIUM_PRICE_AMOUNT=1200
NEXT_PUBLIC_CURRENCY=USD
# Optional bounded payment confirmation checks (milliseconds and attempts).
NEXT_PUBLIC_PAYMENT_POLL_DELAY_MS=2500
NEXT_PUBLIC_PAYMENT_POLL_ATTEMPTS=10
# Optional GitHub repository integration. Composio hosted OAuth, least-privilege GitHub auth config.
COMPOSIO_API_KEY=
COMPOSIO_GITHUB_AUTH_CONFIG_ID=
# Optional tracking; disabled until consent. Keep unset if not needed.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Development only embedded database directory, always on D:.
LOCAL_DATABASE_PATH=D:/Vibecoding/Projects/Ownspace/.ownspace-data

CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_HOSTING_PROVIDER=
NEXT_PUBLIC_DATABASE_PROVIDER=
NEXT_PUBLIC_DATA_REGION=
NEXT_PUBLIC_LOG_RETENTION_DAYS=30
NEXT_PUBLIC_BACKUP_RETENTION_DAYS=30
NEXT_PUBLIC_FINANCIAL_RETENTION_YEARS=7
